doctype html
html
  head
    title Quote of the Day
    style.
      body { font-family: Arial, sans-serif; background-color: #f0f0f0; text-align: center; padding: 50px; }
      h1 { color: #222; }
      blockquote { font-size: 1.5em; font-style: italic; color: #444; }
  body
    h1 Quote of the Day
    blockquote #{quote}